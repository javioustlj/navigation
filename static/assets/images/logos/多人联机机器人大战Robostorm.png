<body>
    <script src="https://s3-eu-west-1.amazonaws.com/apps.playcanvas.com/sf6MAiRf/__start__.js"></script>
    <script src="https://s3-eu-west-1.amazonaws.com/apps.playcanvas.com/sf6MAiRf/__loading__.js"></script>

    <style>
    .MoreGames{position: absolute;bottom: 10px;right: 10px;padding: 5px;background: #009cff;color: #FFF;cursor: pointer;z-index: 999999999;}
    .MoreGames:hover{-ms-transform: scale(1.5, 1.5);-webkit-transform: scale(1.5, 1.5);transform: scale(1.5, 1.5);}
    </style>
    <a id="MoreGamesAd" class="MoreGames" title="More .io Games" href="https://www.freegames66.com/io-games" target="_blank" style="position: absolute;bottom: 10px;right: 10px;padding: 5px;background: #009cff;color: #FFF;cursor: pointer;z-index: 999999999;">More .io Games</a>

    <a id="agBanner" href="http://www.addictinggames.com" target="_blank" style="position: absolute;bottom: 10px;left: 10px;padding: 5px;cursor: pointer;z-index: 999999999; opacity:0.8;"><img src="http://cdn2.addictinggames.com/addictinggames-content/ag-assets/ag-logos/addicting-games-mark-black@1x.png"></a>

    <div id="agText" style="position: absolute;bottom: 105px;left: 127px;padding: 5px;cursor: pointer;z-index: 999999999; opacity:0.8;">More free <a href="http://www.addictinggames.com" target="_blank">games</a></div>

    <script>
        var newAdDiv = document.getElementById("MoreGamesAd");
        var newAdDiv2 = document.getElementById("agBanner");
        var newAdDiv3 = document.getElementById("agText");
        var _pcApp = pc.Application.getApplication();
        if (newAdDiv && newAdDiv2 && _pcApp) {
            var newAdIsShown = true;
            _pcApp.on("update", function() {
                if (!pc.GAMECLIENT || !pc.GAMECLIENT.textRespawn) return;
                var shouldShow = startMenuMode || pc.GAMECLIENT.textRespawn.enabled || finMenuMode || buyMenuMode;
                if (newAdIsShown !== shouldShow) {
                    newAdDiv.style.display = newAdDiv2.style.display = shouldShow ? "block" : "none";
                    newAdIsShown = shouldShow;
                }
            });
        }
        if (startMenu) {
            var childList = startMenu.parentElement.children;
            for(var b=0; b<childList.length; b++) {
                if (childList[b] && childList[b].tagName === "DIV") {
                    if (childList[b].innerHTML.indexOf("Credits") >= 0) {

                        // Remove 2 line breaks
                        childList[b].innerHTML = childList[b].innerHTML.replace('<br><br><a href="https://playcanvas.com" target="_blank">PlayCanvas engine and tools</a><br><br>', '  <a href="https://playcanvas.com" target="_blank">PlayCanvas engine and tools</a>').replace('games:<br><br><div style="width:60%;', 'games:<br><div style="width:100%;').replace("MrSavio", "Georgii Amelekhin");

                        var thisMenu = childList[b];
                        childList[b].children[childList[b].children.length - 1].onclick = function() {
                            thisMenu.style.display = "none";
                        };

                        // Add sponsored pic
                        var sponsored = document.createElement("div");
                        sponsored.innerHTML = '<a id="agBanner2" href="http://www.addictinggames.com" target="_blank" style="position: absolute;bottom: 57px;left: 10px;padding: 5px;cursor: pointer;z-index: 999999999; opacity:0.8;"><img width="320px" src="http://cdn2.addictinggames.com/addictinggames-content/ag-assets/ag-logos/addicting-games-horizontal_rev-sponsor@2x.png"></a>';
                        childList[b].appendChild(sponsored);
                        if (newAdDiv3) {
                            childList[b].appendChild(newAdDiv3);
                            //childList[b].style.height =
                        }

                        break;
                    }
                }
            }
        }
    </script>

</body>
